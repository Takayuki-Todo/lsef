
using namespace System.Management.Automation
using namespace System.Management.Automation.Language

Register-ArgumentCompleter -Native -CommandName 'lsef' -ScriptBlock {
    param($wordToComplete, $commandAst, $cursorPosition)

    $commandElements = $commandAst.CommandElements
    $command = @(
        'lsef'
        for ($i = 1; $i -lt $commandElements.Count; $i++) {
            $element = $commandElements[$i]
            if ($element -isnot [StringConstantExpressionAst] -or
                $element.StringConstantType -ne [StringConstantType]::BareWord -or
                $element.Value.StartsWith('-') -or
                $element.Value -eq $wordToComplete) {
                break
        }
        $element.Value
    }) -join ';'

    $completions = @(switch ($command) {
        'lsef' {
            [CompletionResult]::new('--sort', '--sort', [CompletionResultType]::ParameterName, 'sort by name, size, time, or extension')
            [CompletionResult]::new('--max-depth', '--max-depth', [CompletionResultType]::ParameterName, 'limit recursive depth')
            [CompletionResult]::new('--time-format', '--time-format', [CompletionResultType]::ParameterName, 'local or iso')
            [CompletionResult]::new('--type', '--type', [CompletionResultType]::ParameterName, 'file, dir, directory, or link')
            [CompletionResult]::new('--output', '--output', [CompletionResultType]::ParameterName, 'table, plain, csv, json, or yaml')
            [CompletionResult]::new('--format', '--format', [CompletionResultType]::ParameterName, 'alias for --output')
            [CompletionResult]::new('-a', '-a', [CompletionResultType]::ParameterName, 'include hidden files')
            [CompletionResult]::new('--all', '--all', [CompletionResultType]::ParameterName, 'include hidden files')
            [CompletionResult]::new('-A', '-A ', [CompletionResultType]::ParameterName, 'include hidden and ignored files')
            [CompletionResult]::new('--whole-all', '--whole-all', [CompletionResultType]::ParameterName, 'include hidden and ignored files')
            [CompletionResult]::new('-l', '-l', [CompletionResultType]::ParameterName, 'show extended table columns')
            [CompletionResult]::new('--long', '--long', [CompletionResultType]::ParameterName, 'show extended table columns')
            [CompletionResult]::new('-S', '-S ', [CompletionResultType]::ParameterName, 'sort by size')
            [CompletionResult]::new('-t', '-t', [CompletionResultType]::ParameterName, 'sort by modification time')
            [CompletionResult]::new('-r', '-r', [CompletionResultType]::ParameterName, 'reverse primary sort order')
            [CompletionResult]::new('--reverse', '--reverse', [CompletionResultType]::ParameterName, 'reverse primary sort order')
            [CompletionResult]::new('-R', '-R ', [CompletionResultType]::ParameterName, 'walk subdirectories')
            [CompletionResult]::new('--recursive', '--recursive', [CompletionResultType]::ParameterName, 'walk subdirectories')
            [CompletionResult]::new('--bytes', '--bytes', [CompletionResultType]::ParameterName, 'show raw byte sizes')
            [CompletionResult]::new('--icon', '--icon', [CompletionResultType]::ParameterName, 'prefix names with icons')
            [CompletionResult]::new('--summary', '--summary', [CompletionResultType]::ParameterName, 'append totals')
            [CompletionResult]::new('--sensitive', '--sensitive', [CompletionResultType]::ParameterName, 'mark likely sensitive files')
            [CompletionResult]::new('--completions', '--completions', [CompletionResultType]::ParameterName, 'generate completion files')
            [CompletionResult]::new('--version', '--version', [CompletionResultType]::ParameterName, 'print version')
            [CompletionResult]::new('--help', '--help', [CompletionResultType]::ParameterName, 'print help')
            break
        }
    })

    $completions.Where{ $_.CompletionText -like "$wordToComplete*" } |
        Sort-Object -Property ListItemText
}
